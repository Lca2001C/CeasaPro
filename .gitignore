# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (E2E)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/e2e/.auth/

# Rascunhos de sessão de auditoria/depuração (logs de execução, screenshots,
# scripts de uma vez só). Ficavam na raiz sem regra e entrariam no commit —
# e os logs de `npm run dev` chegam a conter o link de redefinição de senha em
# claro, porque em desenvolvimento ele é impresso de propósito.
tmp-*
