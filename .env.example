# ─────────── App ───────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────── Banco de dados (PostgreSQL) ───────────
# LOCAL: as duas URLs podem ser iguais (Docker / Postgres na máquina).
# VERCEL + NEON:
#   DATABASE_URL  = connection string *pooled* (host *-pooler.*)
#                   acrescente ?pgbouncer=true&connection_limit=1
#   DIRECT_URL    = connection string *direct* (sem -pooler) — só migrations
# RENDER POSTGRES:
#   as duas podem ser a Internal Database URL (já vem com SSL).
#   Se o Prisma reclamar de SSL, acrescente ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ceasapro?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ceasapro?schema=public"

# ─────────── Autenticação (jose) ───────────
# Segredo do access token (JWT). Gere um forte: openssl rand -base64 32
# O refresh token NAO e JWT: e opaco e guardado com hash no banco, por isso
# nao ha um segundo segredo aqui.
JWT_SECRET="troque-por-um-segredo-de-32+bytes"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# ─────────── Seed do super-admin ───────────
SEED_SUPERADMIN_EMAIL="admin@ceasapro.com.br"
SEED_SUPERADMIN_PASSWORD="troque-no-primeiro-login"  # obrigatorio; sem valor padrao no codigo
SEED_DEMO="false"
# SEED_DEMO_PASSWORD="demo123"  # opcional; senha da empresa de exemplo (default: demo123)

# ─────────── Mercado Pago ───────────
# Obrigatórios em produção: MERCADOPAGO_ACCESS_TOKEN, MERCADOPAGO_WEBHOOK_SECRET e APP_URL.
# No painel do Mercado Pago, cadastre o webhook (evento "Pagamentos") em:
#   $APP_URL/api/webhooks/mercadopago
# O mesmo endpoint atende PIX, cartão de crédito e cartão de débito.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="assinatura-secreta-do-painel-mercado-pago"
# Public key exposta ao browser (Payment Brick). Precisa do prefixo NEXT_PUBLIC_.
# Sem segredo (é pública), mas precisa existir no build do client (setar também na Vercel/CI).
# Sem ela a tela de assinatura cai no fallback somente-PIX.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-pub-xxxxxxxx"

# ─────────── E-mail transacional (Resend) ───────────
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="CeasaPro <nao-responda@ceasapro.com.br>"
# Assinatura do endpoint de webhook (painel Resend › Webhooks). Necessária para /api/webhooks/resend.
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxx"
# Opcional: endereço de resposta monitorado (melhora reputacao/anti-spam). Vazio = usa o EMAIL_FROM.
EMAIL_REPLY_TO=""

# ─────────── Cron (recálculo/geração de cobrança) ───────────
CRON_SECRET="token-para-proteger-/api/cron/billing"

# ─────────── Suporte ao cliente ───────────
# Numero do WhatsApp do atendimento, so digitos e com DDI: 55 + DDD + numero.
# Vazio ou ausente = o botao flutuante de suporte nao aparece.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# ─────────── Storage (Cloudflare R2) — logo/anexos (opcional) ───────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
