# ─────────── Regra do prefixo NEXT_PUBLIC_ ───────────
# Tudo que comeca com NEXT_PUBLIC_ e inserido no JavaScript do browser durante o build:
# e publico, e nunca deve guardar segredo. Na Vercel essas variaveis so podem ser
# criadas como "Plain Text" — marcar como "Sensitive" e recusado pelo painel
# ("prefixo publico reservado para o framework"). As demais (DATABASE_URL, JWT_SECRET,
# tokens) devem ser "Sensitive". Tabela completa em docs/09-deploy-vercel.md §3.2.

# ─────────── App ───────────
# APP_URL e a origem de TODO link absoluto (e-mail de redefinicao de senha, e-mail de
# boas-vindas, back_urls do Mercado Pago). Em producao precisa ser https:// e sem barra final.
# Na Vercel, se APP_URL faltar, o servidor cai em VERCEL_PROJECT_PRODUCTION_URL (ou VERCEL_URL
# em preview), injetadas automaticamente, entao o link de senha ainda funciona.
# NEXT_PUBLIC_APP_URL vai para o bundle do browser no build e NAO tem esse fallback —
# defina as duas.
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────── Banco de dados (PostgreSQL) ───────────
# LOCAL: as duas URLs podem ser iguais (Docker / Postgres na máquina).
# PRODUÇÃO (Neon):
#   DATABASE_URL  = connection string *pooled* (host *-pooler.*)
#                   acrescente ?sslmode=require&pgbouncer=true&connection_limit=1
#   DIRECT_URL    = connection string *direct* (sem -pooler), com ?sslmode=require
# As duas sao obrigatorias mesmo na Vercel: a CLI do Prisma (prisma generate, que roda
# no build) valida o bloco datasource inteiro e falha se DIRECT_URL faltar.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ceasapro?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ceasapro?schema=public"

# ─────────── Autenticação (jose) ───────────
# Segredo do access token (JWT). Gere um forte: openssl rand -base64 32
# O refresh token NAO e JWT: e opaco e guardado com hash no banco, por isso
# nao ha um segundo segredo aqui.
JWT_SECRET="troque-por-um-segredo-de-32+bytes"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# ─────────── Seed do super-admin ───────────
SEED_SUPERADMIN_EMAIL="admin@ceasapro.com.br"
SEED_SUPERADMIN_PASSWORD="troque-no-primeiro-login"  # obrigatorio; sem valor padrao no codigo
SEED_DEMO="false"
# SEED_DEMO_PASSWORD="demo123"  # opcional; senha da empresa de exemplo (default: demo123)

# ─────────── Reset de senha do super-admin (scripts/reset-admin-password.ts) ───────────
# Sem ADMIN_PASSWORD o script SORTEIA uma senha e a imprime uma unica vez — prefira
# assim. Nunca coloque a senha no codigo: um segredo commitado fica no historico do
# git mesmo depois de removido do arquivo.
# ADMIN_EMAIL=""      # default: SEED_SUPERADMIN_EMAIL
# ADMIN_PASSWORD=""   # default: sorteada e exibida no terminal

# ─────────── Mercado Pago ───────────
# Obrigatórios em produção: MERCADOPAGO_ACCESS_TOKEN, MERCADOPAGO_WEBHOOK_SECRET e APP_URL.
# No painel do Mercado Pago, cadastre o webhook (evento "Pagamentos") em:
#   $APP_URL/api/webhooks/mercadopago
# O mesmo endpoint atende PIX, cartão de crédito e cartão de débito.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="assinatura-secreta-do-painel-mercado-pago"
# Public key exposta ao browser (Payment Brick). Precisa do prefixo NEXT_PUBLIC_.
# Sem segredo (é pública), mas precisa existir no build do client (setar também na Vercel/CI).
# Sem ela a tela de assinatura cai no fallback somente-PIX.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-pub-xxxxxxxx"

# ─────────── E-mail transacional (SMTP / Gmail) ───────────
# Sem SMTP_USER e SMTP_PASSWORD o envio vira no-op: em dev o link de "esqueci minha senha"
# aparece no log do servidor ([DEV] Link de redefinicao de senha), o que permite testar o
# fluxo inteiro sem caixa de e-mail. Em producao as duas sao obrigatorias.
#
# GMAIL: a senha da conta NAO funciona em SMTP. Gere uma "senha de app":
#   Conta Google -> Seguranca -> Verificacao em duas etapas (precisa estar ativa)
#   -> Senhas de app -> gere uma e cole aqui (16 caracteres, sem espacos).
# Limite do Gmail gratuito: ~500 destinatarios/dia. Google Workspace: ~2.000.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"                       # 465 = TLS implicito; 587 = STARTTLS
SMTP_USER=""
SMTP_PASSWORD="senha-de-app-de-16-caracteres"
# Remetente. O Gmail REESCREVE o From para a conta autenticada quando o endereco e
# outro, entao o normal e usar o proprio SMTP_USER. Vazio = "CeasaPro <SMTP_USER>".
EMAIL_FROM="CeasaPro <seu-endereco@gmail.com>"
# Opcional: endereço de resposta monitorado (melhora reputacao/anti-spam). Vazio = usa o EMAIL_FROM.
EMAIL_REPLY_TO=""

# ─────────── Cron (recálculo/geração de cobrança) ───────────
CRON_SECRET="token-para-proteger-/api/cron/billing"

# ─────────── Rede e cabecalhos de seguranca ───────────
# Quantos proxies CONFIAVEIS ha na frente da aplicacao. O IP do cliente e lido do
# hop contado a partir da DIREITA do x-forwarded-for, porque a esquerda da cadeia e
# escrita pelo proprio cliente — ler a esquerda entregaria ao atacante a chave do
# rate limit do login (cada tentativa viraria uma janela nova) e envenenaria a
# auditoria. Use 1 para Vercel ou para um Nginx/Caddy proprio; 2 para CDN + proxy.
TRUSTED_PROXY_HOPS="1"

# Cookies de sessao vao com `Secure` SEMPRE, exceto se isto for "1".
# A unica razao legitima para ligar: testar na LAN por IP (http://192.168.x.x, PWA no
# celular), onde o navegador nao considera a origem segura e DESCARTA cookie Secure.
# http://localhost ja e contexto seguro, entao o desenvolvimento normal nao precisa.
# NUNCA ligue em producao.
# ALLOW_INSECURE_COOKIES="0"

# Publica o Content-Security-Policy sem aplica-lo (so relatorio). Serve para observar
# violacoes antes de endurecer alguma diretiva. A politica e montada em src/proxy.ts.
# CSP_REPORT_ONLY="0"

# ─────────── Suporte ao cliente ───────────
# Numero do WhatsApp do atendimento, so digitos e com DDI: 55 + DDD + numero.
# Vazio ou ausente = o botao flutuante de suporte nao aparece.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# ─────────── Storage (Cloudflare R2) — logo/anexos (opcional) ───────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
