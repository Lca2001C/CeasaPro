  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ceasaLinks      TenantCeasaLink[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  stockMovements  StockMovement[]

  @@index([tenantId, active])
  @@index([tenantId, name])
  @@map("products")
}

model Supplier {
