  crateMovements PlasticCrateMovement[]
  payments       CrateCleaningPayment[]

  @@index([tenantId, sentDate])
  @@index([tenantId, status])
  @@map("crate_cleanings")
}

/// Cada pagamento ao higienizador, com a data em que saiu do caixa.
///
/// `CrateCleaning.paidAmount` é ACUMULADO e `paidDate` é sobrescrito a cada
/// pagamento, então os dois juntos não dizem quanto saiu em que dia. O fluxo de
/// caixa somava `paidAmount` agrupando por `paidDate`: o pagamento parcelado
/// jogava o valor cheio do lote no dia do ÚLTIMO pagamento, deixava o dia do
/// primeiro sem despesa nenhuma e, se o último caía fora do período, sumia com
/// o lote inteiro do relatório — o mês fechava com saída menor que a real, e é
/// o número que vai para o contador.
///
/// Mesmo desenho de `CreditPayment`, que já existia para o fiado.
model CrateCleaningPayment {
  id         String        @id @default(cuid())
  tenantId   String
  cleaningId String
  amount     Decimal       @db.Decimal(14, 2)
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())
  cleaning   CrateCleaning @relation(fields: [cleaningId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@index([cleaningId])
  @@map("crate_cleaning_payments")
}

model PackagingType {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  active      Boolean             @default(true)
  /// Controla saldo deste tipo? Nasce `false` de propósito: empresa que já
  /// vendia embalagem nunca registrou entrada, e ligar o controle para todos
  /// de uma vez mostraria saldo negativo em tudo — o que é falso, é ausência
  /// de histórico. O dono liga por tipo, informando o que tem hoje.
  tracksStock Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  sales       PackagingSale[]
  movements   PackagingMovement[]
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("packaging_types")
}

/// Livro-razão das embalagens — o saldo é DERIVADO daqui, igual ao de produtos
/// (`stock_movements`). Nunca existe coluna de saldo mutável.
/// Saldo = Σ(ENTRADA, AJUSTE) − Σ(SAIDA, QUEBRA).
model PackagingMovement {
  id              String                @id @default(cuid())
  tenantId        String
  packagingTypeId String
  type            PackagingMovementType
  quantity        Int
  unitCost        Decimal?              @db.Decimal(14, 4)
  reason          String?
  /// Origem do movimento ("PACKAGING_SALE") e o id dela — permite desfazer.
  sourceType      String?
  sourceId        String?
  movedAt         DateTime              @default(now())
  createdAt       DateTime              @default(now())
  packagingType   PackagingType         @relation(fields: [packagingTypeId], references: [id], onDelete: Cascade)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, packagingTypeId])
  @@index([tenantId, movedAt])
  @@index([sourceType, sourceId])
  @@map("packaging_movements")
}

model PackagingSale {
  id              String        @id @default(cuid())
  tenantId        String
  packagingTypeId String
  customerName    String?
  saleDate        DateTime      @default(now())
  quantity        Int
  unitPrice       Decimal       @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  type            PackagingType @relation(fields: [packagingTypeId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, saleDate])
  @@index([tenantId, packagingTypeId])
  @@map("packaging_sales")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  oldData    Json?
  newData    Json?
