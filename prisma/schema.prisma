generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                    String                 @id @default(cuid())
  tradeName             String
  legalName             String?
  cnpj                  String?                @unique
  phone                 String?
  address               String?
  logoUrl               String?
  businessHours         String?
  status                TenantStatus           @default(ACTIVE)
  /// Contador de revogação de sessão da EMPRESA (vai no token como `tev`).
  ///
  /// Bloqueio pelo super-admin, exclusão e estorno/chargeback derrubam todas as
  /// sessões da empresa na hora, em vez de esperar o access token vencer.
  sessionEpoch          Int                    @default(0)
  /// Tipo de estabelecimento / número do box no Ceasa, informado no cadastro
  /// público. Livre e opcional: no Ceasa a mesma pessoa opera box, banca ou
  /// galpão, e travar em enum obrigaria migration a cada arranjo novo.
  establishmentType     String?
  /// Estado em que a empresa opera (sigla de 2 letras).
  ///
  /// Não é derivado da central: existe empresa de cidade de divisa que compra no
  /// estado vizinho, e o módulo de cotações é opcional e pago — quem não o
  /// contrata continua tendo UF. Serve ao cadastro, aos relatórios e a filtrar a
  /// lista de centrais na hora de escolher.
  uf                    String?                @db.Char(2)
  /// Central do CEASA em que esta empresa compra — governa quais cotações ela vê.
  /// Anulável: quem não escolheu ainda cai no estado vazio do módulo, e quem não
  /// tem o módulo no plano nunca preenche. `SetNull` para desativar uma central
  /// não derrubar a empresa junto.
  ceasaCentralCode      String?
  onboardingCompletedAt DateTime?
  /// Prova de aceite dos Termos de Uso / Política de Privacidade (LGPD, art. 8º).
  /// Registrado no primeiro checkout; guardamos data, IP e versão do documento.
  termsAcceptedAt       DateTime?
  termsAcceptedIp       String?
  termsVersion          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  ceasaCentral          CeasaCentral?          @relation(fields: [ceasaCentralCode], references: [code], onDelete: SetNull)
  ceasaLinks            TenantCeasaLink[]
  ceasaAlertas          TenantCeasaAlerta[]
  boletinsEnviados      TenantBoletimEnviado[]
  crateCleanings        CrateCleaning[]
  creditAccounts        CreditAccount[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  packagingMovements    PackagingMovement[]
  packagingSales        PackagingSale[]
  packagingTypes        PackagingType[]
  plasticCrateMovements PlasticCrateMovement[]
  products              Product[]
  purchases             Purchase[]
  reportExports         ReportExport[]
  sales                 Sale[]
  stockMovements        StockMovement[]
  suppliers             Supplier[]
  subscription          TenantSubscription?
  users                 User[]

  @@index([status])
  @@map("tenants")
}

model Plan {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  priceMonthly  Decimal              @db.Decimal(10, 2)
  features      Json?
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions TenantSubscription[]

  @@map("plans")
}

model User {
  id                   String             @id @default(cuid())
  tenantId             String?
  name                 String
  email                String             @unique
  passwordHash         String
  role                 UserRole           @default(OWNER)
  active               Boolean            @default(true)
  mustChangePassword   Boolean            @default(false)
  /// Contador de revogação de sessão do USUÁRIO.
  ///
  /// Vai no access token como `sev` e é conferido nos wrappers de escrita.
  /// Sem ele, a sessão era 100% stateless na leitura: logout, exclusão de
  /// usuário, desativação e troca de senha só mexiam em `refresh_tokens`, e o
  /// access token continuava autorizando tudo por até 15 minutos — enquanto a
  /// tela prometia "todos os dispositivos conectados serão desconectados".
  sessionEpoch         Int                @default(0)
  googleSub            String?            @unique
  lastLoginAt          DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  /// Confirmação do e-mail no cadastro público. É o gatilho do trial: sem isto
  /// preenchido a empresa continua SUSPENSA.
  emailVerifiedAt      DateTime?
  /// SHA-256 do token de confirmação (o token cru só existe no link do e-mail).
  verifyTokenHash      String?
  verifyTokenExpiresAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  refreshTokens        RefreshToken[]
  pushSubscriptions    PushSubscription[]
  tenant               Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([resetTokenHash])
  @@index([verifyTokenHash])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  /// Linhagem de um aparelho: no login recebe o próprio id, e a rotação herda.
  ///
  /// É a unidade que se revoga quando um token roubado é reapresentado. Revogar
  /// a conta inteira derrubaria o celular do dono porque o notebook foi
  /// comprometido; a família é a menor unidade que CERTAMENTE contém o token
  /// vazado.
  /// O default é a hipótese conservadora: um token criado sem linhagem
  /// explícita é a própria linhagem, e revogá-la atinge só ele.
  familyId      String  @default(cuid())
  /// Quem sucedeu este token. Prova que a revogação foi por ROTAÇÃO.
  replacedById  String?
  /// Por que foi revogado. Sem isto, `revokedAt != null` significava quatro
  /// coisas diferentes (rotação, logout, ação do admin, troca de senha) e não
  /// havia como detectar reuso sem transformar todo logout em falso alarme.
  revokedReason String?
  /// Quantas vezes este token já foi aceito dentro da janela de graça.
  ///
  /// Duas abas renovam concorrentemente (`SessaoViva` e `api-client` têm travas
  /// que não se enxergam), e uma resposta perdida faz o cliente reenviar com o
  /// cookie antigo. Sem a janela, esses casos legítimos viravam "ataque".
  graceUses     Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Inscrição de Web Push de UM navegador/dispositivo.
///
/// A chave natural é o `endpoint` (o navegador o gera e ele é único por
/// instalação), por isso ele é `@unique`: reinscrever o mesmo aparelho tem de
/// ATUALIZAR, nunca duplicar — senão a pessoa recebe a mesma notificação N vezes.
///
/// Ligada ao USUÁRIO, não só ao tenant: quem autorizou notificação foi a pessoa,
/// no aparelho dela. Excluir o usuário leva as inscrições com ele (cascade).
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  /// URL do serviço de push do navegador. Único por instalação.
  endpoint   String    @unique
  /// Chave pública do cliente (base64url) — usada na criptografia do payload.
  p256dh     String
  /// Segredo de autenticação do cliente (base64url).
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  /// Último envio ACEITO pelo serviço de push. Ajuda a distinguir inscrição
  /// morta de inscrição só silenciosa.
  lastSentAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("push_subscriptions")
}

/// Contador de rate limit das rotas de autenticação, compartilhado entre as
/// instâncias serverless. A tabela é criada pela migration `20260825140000_rate_limits`;
/// o modelo precisa existir aqui para que `prisma.rateLimit` exista no client
/// (o incremento usa SQL cru, mas a limpeza e o reset usam o client).
model RateLimit {
  keyHash   String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Cotações do CEASA
///
/// As quatro primeiras tabelas NÃO têm `tenantId`, e isso é decisão, não
/// esquecimento: o preço publicado pela central é o mesmo para todo mundo que
/// compra ali. Copiá-lo por empresa multiplicaria a importação por número de
/// clientes e faria a tabela crescer sem nenhum ganho. Elas seguem o molde de
/// `RateLimit` — sem relação com Tenant, acesso pelo `prisma` cru — e por
/// construção ficam fora de `TENANT_MODELS`.
///
/// Só `TenantCeasaLink` tem `tenantId`: é a única coisa privada aqui, porque é a
/// decisão de UMA empresa sobre o produto DELA.
/// ─────────────────────────────────────────────────────────────────────────────

/// Entreposto do CEASA (Grande BH, Juiz de Fora, Uberlândia...).
model CeasaCentral {
  /// Código estável do entreposto na fonte (ex.: "CEAMG"). É PK textual porque o
  /// importador referencia a central por código, não por id gerado — mesmo
  /// raciocínio de `RateLimit.keyHash`.
  code              String           @id
  name              String
  city              String
  uf                String
  /// Qual implementação de `FonteDeCotacao` atende esta central.
  sourceKey         String
  /// Parâmetros que a fonte precisa (ex.: `{"mercado":"CEAMG"}`). Fica em Json
  /// para uma central nova não exigir migration.
  sourceParams      Json?
  /// Permite desligar uma fonte quebrada SEM deploy.
  active            Boolean          @default(true)
  /// Quantos dias sem boletim ainda são NORMAIS para esta central.
  ///
  /// Medido contra a fonte real: Grande BH e Grande Vitória publicam quase todo
  /// dia útil, mas Juiz de Fora, Barbacena, Caratinga e Poços de Caldas publicam
  /// 2 a 3 vezes por semana. Um limiar único faria essas quatro dispararem
  /// alarme de defasagem para sempre — e alarme que grita toda semana é ignorado
  /// em um mês, levando junto o alarme da quebra de verdade.
  ///
  /// É o mesmo número que a tela do cliente usa para o selo de "boletim antigo",
  /// para tela e alarme nunca discordarem.
  maxDiasSemBoletim Int              @default(7)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  quotes            CeasaQuote[]
  importRuns        CeasaImportRun[]
  tenants           Tenant[]
  boletinsEnviados  TenantBoletimEnviado[]

  @@index([active, sortOrder])
  @@map("ceasa_centrals")
}

/// Produto como o boletim escreve ("TOMATE SALADA LONGA VIDA").
///
/// Catálogo GLOBAL, não por central: assim o vínculo que a empresa fez sobrevive
/// à troca de central quando o nome coincide.
model CeasaProduct {
  id          String            @id @default(cuid())
  /// Nome de exibição, como veio da fonte.
  name        String
  /// A que TAXONOMIA este produto pertence.
  ///
  /// Não é o mesmo que `sourceKey` da central, e a diferença importa: `sourceKey`
  /// responde "quem busca", `serie` responde "que tipo de número é este". Um
  /// raspador novo de outra central seria um `sourceKey` novo na MESMA série
  /// CENTRAL, e comparar as duas seria legítimo.
  ///
  /// Existe porque as duas taxonomias COLIDEM de verdade, não em teoria. Medido
  /// contra o boletim real e o catálogo nacional: `UVA ITALIA` e `UVA NIAGARA`
  /// aparecem com nome idêntico E unidade idêntica ("KG") nas duas fontes. Com
  /// `slug` único global, isso dá o MESMO `CeasaProduct`, e aí a chave inteira de
  /// `CeasaQuote` (central, data, produto, unidade) coincide — o `ON CONFLICT DO
  /// UPDATE` da gravação faz a última importação do dia sobrescrever a outra em
  /// silêncio, apagando o mínimo e o máximo reais quando a série nacional (que só
  /// tem um preço) chega por último.
  ///
  /// Pôr o discriminador AQUI, e não em `CeasaQuote`, é o que faz o banco
  /// PROIBIR o casamento entre taxonomias em vez de apenas documentá-lo: um
  /// produto de catálogo pertence a exatamente uma série, e não há como gravar um
  /// produto alimentado pelas duas fontes.
  serie       CeasaSerie        @default(CENTRAL)
  /// `normalizarNome(name)` — minúsculas, sem acento, espaços colapsados.
  /// Impede o catálogo de ganhar linha nova todo dia só porque o boletim imprimiu
  /// dois espaços. Único DENTRO da série (ver `@@unique` abaixo).
  slug        String
  firstSeenAt DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())
  active      Boolean           @default(true)
  quotes      CeasaQuote[]
  links       TenantCeasaLink[]
  alertas     TenantCeasaAlerta[]

  /// Único DENTRO da série, não global. É esta linha que separa as taxonomias:
  /// `uva-italia` da série CENTRAL e `uva-italia` da NACIONAL passam a ser dois
  /// produtos, então a chave de `CeasaQuote` já difere e a sobrescrita silenciosa
  /// deixa de ser possível — sem precisar mexer na chave de `CeasaQuote`.
  @@unique([serie, slug])
  @@index([active, name])
  @@index([serie, active, name])
  @@map("ceasa_products")
}

/// A que taxonomia um produto de catálogo pertence.
///
/// As duas NÃO são comparáveis e não podem virar um mesmo número na tela:
///
/// - `CENTRAL`: o boletim da própria praça. Produto ESPECÍFICO, com cultivar e
///   classificação no nome ("TOMATE SALADA LONGA VIDA", "BANANA PRATA CLIM EXT"),
///   com mínimo/comum/máximo. Hoje só MG e ES têm.
/// - `NACIONAL`: a série agregada do país. Produto GENÉRICO ("TOMATE"), preço
///   único, cobertura ampla e história longa — é o que serve a histórico,
///   sazonalidade e comparação entre praças.
enum CeasaSerie {
  CENTRAL
  NACIONAL
}

/// Preço de um produto, numa central, num dia.
model CeasaQuote {
  centralCode    String
  ceasaProductId String
  /// Data do BOLETIM, não do fetch. `@db.Date` porque é data de calendário e não
  /// instante — evita de saída todo o problema de fuso que `src/lib/tz.ts` existe
  /// para resolver.
  quoteDate      DateTime     @db.Date
  /// Embalagem cotada, como a fonte escreve. Medido no boletim real: 80% é "KG",
  /// depois "DZ", e o resto compostas ("CX 30 DZ", "DZ 4 KG", "UN 1,5 KG").
  /// NOT NULL com default "" de propósito:
  /// no Postgres vários NULL não colidem em índice único, então com `unit` nulo
  /// o upsert duplicaria a linha a cada reimportação do mesmo dia.
  unit           String       @default("")
  minPrice       Decimal?     @db.Decimal(14, 2)
  avgPrice       Decimal?     @db.Decimal(14, 2)
  maxPrice       Decimal?     @db.Decimal(14, 2)
  /// O preço que a TELA mostra, escolhido pelo adaptador — que é quem conhece a
  /// semântica da fonte (moda? média? preço único?). Sem ele cada tela
  /// reimplementaria o fallback e elas divergiriam, que foi exatamente o defeito
  /// que `custoMedioPonderado` corrigiu no estoque.
  refPrice       Decimal      @db.Decimal(14, 2)
  importedAt     DateTime     @default(now())
  central        CeasaCentral @relation(fields: [centralCode], references: [code], onDelete: Cascade)
  product        CeasaProduct @relation(fields: [ceasaProductId], references: [id], onDelete: Cascade)

  /// A chave NATURAL é a chave primária — não há `id` sintético.
  ///
  /// Medido com 205 mil cotações: a chave primária de cuid ocupava 15 MB (23% da
  /// tabela) e tinha ZERO leituras — nada busca cotação por id, e nenhuma tabela
  /// aponta para ela. Era um índice pago em espaço e em uma escrita a mais por
  /// linha inserida, sem nenhuma leitura em troca.
  ///
  /// A UNIDADE entra na chave porque o boletim cota o mesmo produto em
  /// embalagens diferentes com preços diferentes; colapsar seria perder dado ou
  /// escolher um no escuro. E o produto já carrega a série, então duas taxonomias
  /// nunca disputam a mesma linha.
  ///
  /// Reimportar o mesmo dia atualiza, não duplica.
  @@id([centralCode, quoteDate, ceasaProductId, unit])
  @@index([centralCode, quoteDate])
  /// O caminho de leitura do HISTÓRICO: um produto ao longo do tempo.
  ///
  /// O índice acima serve a "um dia inteiro de uma praça" — que é o painel. A
  /// tela de histórico faz a pergunta transposta ("este produto, nos últimos 365
  /// dias") e o comparativo faz "este produto, em todas as praças", e nenhuma das
  /// duas tem prefixo utilizável ali.
  ///
  /// Medido com 205 mil cotações: o comparativo entre praças fazia SEQ SCAN da
  /// tabela inteira, descartando 66.815 linhas por worker para devolver 39, em
  /// 11,9 ms e 3.845 páginas. Com este índice: 3,9 ms e 151 páginas. O histórico
  /// de 365 dias caiu de 2,5 ms para 1,4 ms.
  ///
  /// O custo é real e medido: +12 MB de índice sobre 205 mil linhas. Aceito
  /// porque o seq scan é O(tabela) numa tabela que só cresce — hoje custa 12 ms,
  /// e no terceiro ano de histórico custaria o triplo, em toda abertura de
  /// produto. A `unit` NÃO entra: medida com e sem, a deduplicação do B-tree
  /// absorve a coluna repetida e o índice dá 12 MB dos dois jeitos, com o mesmo
  /// tempo — então ela fica como filtro, e o índice fica com uma coluna a menos.
  @@index([ceasaProductId, centralCode, quoteDate])
  @@map("ceasa_quotes")
}

/// Log de toda tentativa de importação — é o que torna a falha visível.
model CeasaImportRun {
  id           String            @id @default(cuid())
  centralCode  String
  sourceKey    String
  quoteDate    DateTime?         @db.Date
  status       CeasaImportStatus
  rowsParsed   Int               @default(0)
  rowsUpserted Int               @default(0)
  durationMs   Int               @default(0)
  httpStatus   Int?
  error        String?
  /// Assinatura ESTRUTURAL da resposta (hash dos cabeçalhos da tabela de dados).
  /// Quando muda em relação à última execução OK, dispara aviso mesmo com o
  /// parsing tendo dado certo — é a única camada que pega corrupção silenciosa,
  /// do tipo "colunas trocadas, mínimo virou máximo".
  fingerprint  String?
  startedAt    DateTime          @default(now())
  finishedAt   DateTime?
  central      CeasaCentral      @relation(fields: [centralCode], references: [code], onDelete: Cascade)

  @@index([centralCode, startedAt])
  @@map("ceasa_import_runs")
}

/// O produto do cliente ↔ o produto do boletim.
///
/// Vínculo MANUAL, e é a decisão central do módulo. Casamento exato por nome
/// normalizado quase nunca acerta ("Tomate" não é "TOMATE SALADA LONGA VIDA"), e
/// similaridade por trigrama acerta — mas casa "TOMATE CEREJA" com "TOMATE
/// SALADA", que são preços diferentes, em silêncio. Num módulo cujo propósito é
/// orientar preço, mostrar o preço errado com cara de certo é pior que não
/// mostrar preço nenhum.
model TenantCeasaLink {
  id             String       @id @default(cuid())
  tenantId       String
  productId      String
  ceasaProductId String
  /// A embalagem do boletim que este produto é — "minha caixa", não "o quilo".
  ///
  /// Três valores distintos, e a diferença importa:
  ///
  ///     NULL   o cliente não escolheu  → o vínculo vale para TODAS as embalagens
  ///     ''     o boletim não informou  → vale só para a linha sem embalagem
  ///     'KG'   o cliente escolheu      → vale só para o quilo
  ///
  /// Anulável, e não `NOT NULL @default("")` como em `CeasaQuote.unit`: lá a
  /// unidade entra num índice único, e vários NULL não colidem em índice único no
  /// Postgres. Aqui ela NÃO entra na chave, então o `''` só custaria significado —
  /// o vínculo legítimo à embalagem em branco (comum na praça manual, que é 57 das
  /// 66 do catálogo) ficaria indistinguível de "qualquer embalagem".
  unit           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  ceasaProduct   CeasaProduct @relation(fields: [ceasaProductId], references: [id], onDelete: Cascade)

  /// Um produto do boletim por produto seu. NÃO o inverso: "Tomate caixa" e
  /// "Tomate kg" podem apontar para o mesmo item do boletim.
  @@unique([tenantId, productId])
  @@index([tenantId, ceasaProductId])
  @@map("tenant_ceasa_links")
}

/// Alerta de flutuação de preço que UMA empresa pediu para um item do boletim.
///
/// É o segundo (e último) modelo do módulo com `tenantId`: preço é público, mas
/// "me avise se a batata subir 10%" é decisão de uma empresa só.
///
/// A UNIDADE entra na chave junto com o produto, e isso não é detalhe. O mesmo
/// item é cotado por quilo e por caixa, com preços de ordem de grandeza
/// diferente — um teto de R$ 5,00 é barato para a caixa e caro para o quilo.
/// Sem a unidade, o alerta dispararia comparando embalagens e o comerciante
/// receberia "subiu 1.900%" toda vez que a praça trocasse de embalagem no
/// boletim.
model TenantCeasaAlerta {
  id             String   @id @default(cuid())
  tenantId       String
  ceasaProductId String
  unit           String   @default("")
  /// De quantos por cento para cima OU para baixo o movimento merece aviso.
  ///
  /// Guardado por alerta, e não fixo no código, porque a tolerância é do
  /// produto: cebola oscila muito mais que batata, e um limiar único faria a
  /// cebola avisar todo dia (virando ruído) e a batata quase nunca.
  variacaoMinima Decimal  @db.Decimal(5, 2)
  /// Avisar quando o preço PASSAR deste valor — está caro para comprar.
  precoTeto      Decimal? @db.Decimal(14, 2)
  /// Avisar quando o preço CAIR abaixo deste valor — é hora de comprar.
  precoPiso      Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ceasaProduct   CeasaProduct @relation(fields: [ceasaProductId], references: [id], onDelete: Cascade)

  /// Um alerta por item+embalagem. Reconfigurar atualiza, não empilha.
  @@unique([tenantId, ceasaProductId, unit])
  @@index([tenantId])
  @@map("tenant_ceasa_alertas")
}

/// Boletim que o CLIENTE enviou, esperando o super-admin publicar.
///
/// Rascunho, e é o ponto todo. Das 66 praças do catálogo, 57 não têm raspador: o
/// boletim delas depende de alguém colar. Deixar o cliente colar direto em
/// `ceasa_quotes` resolveria o gargalo e abriria quatro buracos — `gravar`
/// sobrescreve (`ON CONFLICT DO UPDATE`), escreve no catálogo GLOBAL
/// `ceasa_products`, publica preço que os concorrentes dele leem, e nenhum dos
/// três alarmes vigia praça manual. Como toda leitura parte de `MAX(quoteDate)`,
/// o dado ruim seria permanente.
///
/// Então o envio para AQUI, visível só para quem enviou, e publicar continua
/// sendo ato do super-admin — pelo mesmo `gravar`, do lado de dentro da fronteira
/// de confiança que já existia.
model TenantBoletimEnviado {
  id              String               @id @default(cuid())
  tenantId        String
  centralCode     String
  quoteDate       DateTime             @db.Date
  /// O texto COLADO, não as linhas parseadas.
  ///
  /// É o que permite ao operador ver o que o cliente realmente mandou quando o
  /// parse discorda do esperado, e reprocessar sem pedir para colar de novo.
  textoCru        String
  linhasValidas   Int                  @default(0)
  linhasIgnoradas Int                  @default(0)
  status          BoletimEnviadoStatus @default(PENDENTE)
  /// Por que foi recusado — o cliente tem direito de saber, senão reenvia igual.
  motivo          String?
  revisadoPor     String?
  revisadoEm      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  central         CeasaCentral         @relation(fields: [centralCode], references: [code], onDelete: Cascade)

  /// A fila do operador: pendentes primeiro, mais antigo antes.
  @@index([status, createdAt])
  /// "O que eu enviei", na tela do cliente.
  @@index([tenantId, createdAt])
  @@map("tenant_boletins_enviados")
}

enum BoletimEnviadoStatus {
  PENDENTE
  PUBLICADO
  RECUSADO
}

model TenantSubscription {
  id               String                @id @default(cuid())
  tenantId         String                @unique
  planId           String
  status           SubscriptionStatus    @default(SUSPENSO)
  statusSource     StatusSource          @default(AUTO)
  statusReason     String?
  monthlyAmount    Decimal               @db.Decimal(10, 2)
  startedAt        DateTime              @default(now())
  /// Data do PRIMEIRO pagamento aprovado. Enquanto for null a empresa nunca pagou,
  /// então não tem direito à tolerância de `graceDays` — só ao trial, se houver.
  activatedAt      DateTime?
  /// Fim dos 7 dias grátis do cadastro público. Só é preenchido quando o e-mail é
  /// confirmado (sem isso, e-mail descartável renderia trial ilimitado). Null =
  /// nunca teve trial; passado = trial encerrado.
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime
  /// Tolerância em dias após o vencimento — só vale para quem já tem `activatedAt`.
  graceDays        Int                   @default(5)
  mpCustomerId     String?
  cancelledAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  payments         SubscriptionPayment[]
  plan             Plan                  @relation(fields: [planId], references: [id])
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@map("tenant_subscriptions")
}

model SubscriptionPayment {
  id             String             @id @default(cuid())
  subscriptionId String
  tenantId       String
  amount         Decimal            @db.Decimal(10, 2)
  status         PaymentStatus      @default(PENDENTE)
  method         ChargeMethod?
  statusDetail   String?
  referenceMonth String
  mpPaymentId    String?            @unique
  mpPreferenceId String?
  mpExternalRef  String?
  qrCode         String?
  qrCodeBase64   String?
  ticketUrl      String?
  threeDsUrl     String?
  expiresAt      DateTime?
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  rawPayload     Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("subscription_payments")
}

model Product {
