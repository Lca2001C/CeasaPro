  createdAt  DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Caixa de entrada do super-admin: o que aconteceu na operação do SaaS e ele
/// precisa ver, com estado de lido.
///
/// É uma caixa COMPARTILHADA entre os super-admins, não uma por pessoa: o aviso
/// é sobre o negócio ("entrou um cadastro novo"), não sobre alguém. Dois
/// administradores marcando o mesmo cadastro como lido seria trabalho repetido.
///
/// Sem relação (FK) com Tenant/User, na mesma linha do `AuditLog`: o registro do
/// que aconteceu precisa sobreviver à exclusão da empresa que o originou. Por
/// isso os testes limpam esta tabela explicitamente.
model AdminNotification {
  id        String                @id @default(cuid())
  kind      AdminNotificationKind
  title     String
  body      String
  /// Tela para onde o clique leva. Caminho relativo do app.
  href      String?
  tenantId  String?
  userId    String?
  readAt    DateTime?
  createdAt DateTime              @default(now())

  /// Serve a consulta que a campainha faz em toda página do admin: contar as
  /// não lidas e listar as mais recentes primeiro.
  @@index([readAt, createdAt])
  @@map("admin_notifications")
}

enum AdminNotificationKind {
  /// Conta criada: cadastro público (autoatendimento) ou cadastro pelo admin.
  USER_CREATED
  /// A importação do boletim de uma central falhou, ou o formato da fonte mudou.
  ///
  /// Raspagem quebra quando o site de origem muda, e o desfecho normal é o
  /// módulo morrer sem ninguém perceber. Este aviso é o que torna a quebra
  /// visível para quem pode consertar.
  COTACOES_FALHA
  /// Uma central com clientes está sem boletim novo há dias.
  ///
  /// Independe do motivo — rede, formato, feriado emendado, central desligada
  /// por engano, ou bug na própria detecção de falha. É o único alarme que um
  /// defeito nos outros não desarma.
  COTACOES_DESATUALIZADAS
  /// Um cliente enviou o boletim da praça dele e espera publicação.
  ///
  /// Sem este aviso a fila só seria vista por quem abrisse `/admin/cotacoes` por
  /// conta própria — e um envio que fica dias parado é pior que não ter o
  /// recurso: o cliente fez a parte dele e o preço continua não aparecendo.
  COTACOES_ENVIO_CLIENTE
}

/// Desfecho de uma tentativa de importar boletim.
///
/// Três estados, e não dois, de propósito: `VAZIO` é a fonte respondendo
/// corretamente que não há boletim naquele dia (domingo, feriado, publicação
/// atrasada) e NÃO é falha. Sem essa distinção o alarme dispararia todo fim de
/// semana, seria ignorado em um mês, e aí o módulo morreria em silêncio do
/// mesmo jeito — só que com um alarme instalado dando a impressão contrária.
enum CeasaImportStatus {
  OK
  VAZIO
  FALHA
}

enum UserRole {
  SUPER_ADMIN
  OWNER
}

enum SaleUnit {
  CAIXA
  KG
  SACO
  BANDEJA
  UNIDADE
}

enum RecipientType {
  PLASTICA
  PAPELAO
  MADEIRA
}

enum PaymentMethod {
  PIX
