// CeasaPro — schema Prisma (MVP + plataforma/billing + AuditLog)
// Regras: dinheiro em Decimal(14,2); quantidades Decimal(14,3); nunca Float.
// Toda tabela operacional tem tenantId + createdAt/updatedAt + deletedAt (soft delete).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon/PgBouncer) — queries da app
  directUrl = env("DIRECT_URL") // direta — migrations (`prisma migrate deploy`)
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  SUPER_ADMIN
  OWNER
}

enum SaleUnit {
  CAIXA
  KG
  SACO
  BANDEJA
  UNIDADE
}

enum RecipientType {
  PLASTICA
  PAPELAO
  MADEIRA
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO
  FIADO
}

enum CreditStatus {
  EM_ABERTO
  PAGO
}

enum StockMovementType {
  ENTRADA
  SAIDA
  QUEBRA
  DOACAO
  AJUSTE
}

enum ExpenseType {
  FIXA
  VARIAVEL
}

enum ExpenseStatus {
  PENDENTE
  PAGO
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

/// Não existe período gratuito: a empresa nasce SUSPENSA e só vai para ATIVO
/// quando o primeiro pagamento é aprovado pelo Mercado Pago.
enum SubscriptionStatus {
  ATIVO
  VENCIDO
  SUSPENSO
  BLOQUEADO
  CANCELADO
}

enum StatusSource {
  AUTO
  MANUAL
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
  CANCELADO
}

/// Forma de pagamento da mensalidade (assinatura do SaaS).
/// Não confundir com `PaymentMethod`, que é a forma de pagamento de uma VENDA.
enum ChargeMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum ReportType {
  VENDAS
  COMPRAS
  ESTOQUE
  FIADO
  INADIMPLENTES
  FORNECEDORES
  DESPESAS
  FLUXO_CAIXA
  LUCRO_PRODUTO
  LUCRO_FORNECEDOR
  MAIS_VENDIDOS
  PRODUTOS_PREJUIZO
  ESTOQUE_PARADO
  CAIXAS_PAPELAO
  CAIXAS_PLASTICAS
  HIGIENIZACAO
  EMBALAGENS
}

enum PlasticCrateMovementType {
  ENTRADA // caixas recebidas (com mercadoria comprada ou avulsas)
  SAIDA // caixas enviadas ao cliente
  RETORNO // caixas devolvidas pelo cliente (voltam sujas)
  QUEBRA // quebrada/perdida/sumida (com cliente, no higienizador ou no estoque)
  SAIDA_HIGIENIZACAO // caixas sujas enviadas ao higienizador
  RETORNO_HIGIENIZACAO // caixas devolvidas limpas pelo higienizador
}

enum CrateCleaningStatus {
  ENVIADO
  DEVOLVIDO
  PAGO
}

enum ReportFormat {
  PDF
  EXCEL
}

enum ReportStatus {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  ERRO
}

// ───────────────────────── Plataforma / SaaS ─────────────────────────

model Tenant {
  id                    String       @id @default(cuid())
  tradeName             String // nome fantasia
  legalName             String? // razão social
  cnpj                  String?      @unique
  phone                 String?
  address               String?
  logoUrl               String?
  businessHours         String?
  status                TenantStatus @default(ACTIVE)
  onboardingCompletedAt DateTime?
  /// Prova de aceite dos Termos de Uso / Política de Privacidade (LGPD, art. 8º).
  /// Registrado no primeiro checkout; guardamos data, IP e versão do documento.
  termsAcceptedAt       DateTime?
  termsAcceptedIp       String?
  termsVersion          String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  users                 User[]
  subscription          TenantSubscription?
  products              Product[]
  suppliers             Supplier[]
  purchases             Purchase[]
  sales                 Sale[]
  creditAccounts        CreditAccount[]
  stockMovements        StockMovement[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  reportExports         ReportExport[]
  plasticCrateMovements PlasticCrateMovement[]
  crateCleanings        CrateCleaning[]
  packagingTypes        PackagingType[]
  packagingSales        PackagingSale[]

  @@index([status])
  @@map("tenants")
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  priceMonthly Decimal  @db.Decimal(10, 2)
  maxUsers     Int?
  features     Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@map("plans")
}

model User {
  id                  String    @id @default(cuid())
  tenantId            String? // NULL apenas para SUPER_ADMIN
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(OWNER)
  active              Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  lastLoginAt         DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  // Busca do fluxo "esqueci minha senha": sem indice, cada link clicado varre a tabela inteira.
  @@index([resetTokenHash])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model TenantSubscription {
  id               String             @id @default(cuid())
  tenantId         String             @unique
  planId           String
  status           SubscriptionStatus @default(SUSPENSO)
  statusSource     StatusSource       @default(AUTO)
  statusReason     String?
  monthlyAmount    Decimal            @db.Decimal(10, 2)
  startedAt        DateTime           @default(now())
  /// Data do PRIMEIRO pagamento aprovado. Enquanto for null a empresa nunca pagou,
  /// então não tem acesso nem direito à tolerância de `graceDays`.
  activatedAt      DateTime?
  currentPeriodEnd DateTime
  /// Tolerância em dias após o vencimento — só vale para quem já tem `activatedAt`.
  graceDays        Int                @default(5)
  mpCustomerId     String?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([status, currentPeriodEnd])
  @@map("tenant_subscriptions")
}

model SubscriptionPayment {
  id             String        @id @default(cuid())
  subscriptionId String
  tenantId       String
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDENTE)
  method         ChargeMethod?
  statusDetail   String? // status_detail do Mercado Pago (accredited, pending_challenge, cc_rejected_*)
  referenceMonth String // "2026-07"
  mpPaymentId    String?       @unique
  mpPreferenceId String?
  mpExternalRef  String?
  qrCode         String?       @db.Text
  qrCodeBase64   String?       @db.Text
  ticketUrl      String?
  threeDsUrl     String?       @db.Text // desafio 3DS do débito (three_ds_info.external_resource_url)
  expiresAt      DateTime? // validade do QR PIX / da preferência de cartão (renovado pelo app quando vence)
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  rawPayload     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("subscription_payments")
}

// ───────────────────────── Operacionais ─────────────────────────

model Product {
  id              String         @id @default(cuid())
  tenantId        String
  name            String
  saleUnit        SaleUnit
  qtyPerRecipient Decimal?       @db.Decimal(14, 3)
  recipientType   RecipientType?
  sackCapacity    Decimal?       @db.Decimal(14, 3)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([tenantId, active])
  @@index([tenantId, name])
  @@map("products")
}

model Supplier {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  address   String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId, name])
  @@map("suppliers")
}

model Purchase {
  id           String    @id @default(cuid())
  tenantId     String
  supplierId   String?
  purchaseDate DateTime
  freight      Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount  Decimal   @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseItem[]

  @@index([tenantId, purchaseDate])
  @@index([tenantId, supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id                 String         @id @default(cuid())
  tenantId           String
  purchaseId         String
  productId          String
  quantity           Decimal        @db.Decimal(14, 3)
  unitPrice          Decimal        @db.Decimal(14, 2)
  recipientType      RecipientType?
  freightShare       Decimal        @default(0) @db.Decimal(14, 2)
  unitCost           Decimal        @db.Decimal(14, 4)
  lineTotal          Decimal        @db.Decimal(14, 2)
  suggestedSalePrice Decimal?       @db.Decimal(14, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId])
  @@index([purchaseId])
  @@map("purchase_items")
}

model Sale {
  id              String        @id @default(cuid())
  tenantId        String
  customerName    String?
  saleDate        DateTime      @default(now())
  paymentMethod   PaymentMethod
  totalAmount     Decimal       @db.Decimal(14, 2)
  plasticCrateQty Int           @default(0) // caixas plásticas que saíram nesta venda
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          SaleItem[]
  creditAccount  CreditAccount?
  crateMovements PlasticCrateMovement[]

  @@index([tenantId, saleDate])
  @@index([tenantId, paymentMethod])
  @@map("sales")
}

model SaleItem {
  id             String         @id @default(cuid())
  tenantId       String
  saleId         String
  productId      String
  quantity       Decimal        @db.Decimal(14, 3)
  unitPrice      Decimal        @db.Decimal(14, 2)
  recipientType  RecipientType?
  crateQty       Int            @default(0) // caixas/vasilhames deste item
  lineTotal      Decimal        @db.Decimal(14, 2)
  unitCostAtSale Decimal        @default(0) @db.Decimal(14, 4)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId])
  @@index([saleId])
  @@map("sale_items")
}

model CreditAccount {
  id            String       @id @default(cuid())
  tenantId      String
  saleId        String?      @unique
  customerName  String
  customerPhone String?
  totalAmount   Decimal      @db.Decimal(14, 2)
  paidAmount    Decimal      @default(0) @db.Decimal(14, 2)
  status        CreditStatus @default(EM_ABERTO)
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale     Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payments CreditPayment[]

  @@index([tenantId, status])
  @@index([tenantId, customerName])
  @@map("credit_accounts")
}

model CreditPayment {
  id        String        @id @default(cuid())
  tenantId  String
  accountId String
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod @default(DINHEIRO)
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@index([accountId])
  @@map("credit_payments")
}

model StockMovement {
  id         String            @id @default(cuid())
  tenantId   String
  productId  String
  type       StockMovementType
  quantity   Decimal           @db.Decimal(14, 3)
  unitCost   Decimal?          @db.Decimal(14, 4)
  reason     String?
  sourceType String? // "PURCHASE" | "SALE" | "MANUAL"
  sourceId   String?
  movedAt    DateTime          @default(now())
  createdAt  DateTime          @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, movedAt])
  @@index([tenantId, type])
  @@map("stock_movements")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(cuid())
  tenantId    String
  categoryId  String?
  description String
  amount      Decimal       @db.Decimal(14, 2)
  dueDate     DateTime?
  paidDate    DateTime?
  type        ExpenseType
  status      ExpenseStatus @default(PENDENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("expenses")
}

model ReportExport {
  id           String       @id @default(cuid())
  tenantId     String
  userId       String?
  type         ReportType
  format       ReportFormat
  status       ReportStatus @default(CONCLUIDO)
  periodStart  DateTime?
  periodEnd    DateTime?
  filters      Json?
  rowCount     Int?
  fileName     String?
  errorMessage String?
  createdAt    DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@map("report_exports")
}

// ───────────────────── Fase 2: caixas, higienização, embalagens ─────────────────────

// Ledger de caixas plásticas — append-only, saldos são DERIVADOS (soma dos movimentos).
model PlasticCrateMovement {
  id              String                   @id @default(cuid())
  tenantId        String
  type            PlasticCrateMovementType
  quantity        Int // sempre positivo; o "sinal" vem do type
  brokenQty       Int                      @default(0) // caixas que já chegaram quebradas (na ENTRADA)
  dirty           Boolean                  @default(false) // false = pote "limpas"; true = pote "sujas"
  customerName    String? // cliente (SAIDA/RETORNO; na QUEBRA indica perda com cliente)
  supplierName    String? // origem/fornecedor (ENTRADA)
  cleanerName     String? // higienizador (SAIDA/RETORNO_HIGIENIZACAO; na QUEBRA indica perda no higienizador)
  saleId          String? // venda que originou a saída de caixas
  crateCleaningId String? // lote de higienização que originou o movimento
  movementDate    DateTime                 @default(now())
  notes           String?
  createdAt       DateTime                 @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  crateCleaning CrateCleaning? @relation(fields: [crateCleaningId], references: [id], onDelete: SetNull)

  @@index([tenantId, movementDate])
  @@index([tenantId, type])
  @@index([tenantId, customerName])
  @@index([saleId])
  @@index([crateCleaningId])
  @@map("plastic_crate_movements")
}

model CrateCleaning {
  id           String              @id @default(cuid())
  tenantId     String
  cleanerName  String // higienizador responsável
  sentDate     DateTime
  sentQty      Int
  unitPrice    Decimal             @db.Decimal(14, 2)
  totalAmount  Decimal             @db.Decimal(14, 2) // sentQty * unitPrice
  returnedQty  Int                 @default(0)
  returnedDate DateTime?
  paidAmount   Decimal             @default(0) @db.Decimal(14, 2)
  paidDate     DateTime?
  status       CrateCleaningStatus @default(ENVIADO)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crateMovements PlasticCrateMovement[]

  @@index([tenantId, sentDate])
  @@index([tenantId, status])
  @@map("crate_cleanings")
}

model PackagingType {
  id        String    @id @default(cuid())
  tenantId  String
  name      String // "Caixa plástica", "Papelão", "Madeira", "Sacaria", ...
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  PackagingSale[]

  @@unique([tenantId, name])
  @@map("packaging_types")
}

model PackagingSale {
  id              String    @id @default(cuid())
  tenantId        String
  packagingTypeId String
  customerName    String?
  saleDate        DateTime  @default(now())
  quantity        Int
  unitPrice       Decimal   @db.Decimal(14, 2)
  totalAmount     Decimal   @db.Decimal(14, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type   PackagingType @relation(fields: [packagingTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId, saleDate])
  @@index([tenantId, packagingTypeId])
  @@map("packaging_sales")
}

// AuditLog — trilha imutável; SEM relação/cascade (o log deve sobreviver ao soft-delete do tenant).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  actorEmail String?
  action     String // "CREATE" | "UPDATE" | "DELETE" | ...
  entity     String // "Sale" | "Purchase" | ...
  entityId   String?
  oldData    Json?
  newData    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Contador de rate limit das rotas de autenticação.
///
/// Fica no banco, e não em memória, porque em serverless (Vercel) cada request
/// pode cair numa instância diferente — um contador em processo não seguraria
/// força bruta no login. O throttle por empresa (`with-route.ts`) continua em
/// memória de propósito: lá o objetivo é conter abuso acidental, e não vale uma
/// ida ao banco por request.
model RateLimit {
  /// SHA-256 da chave lógica ("login:<ip>:<email>"). Hash, e não texto puro:
  /// a chave carrega IP e e-mail, que são dado pessoal.
  keyHash   String   @id
  count     Int      @default(1)
  expiresAt DateTime

  /// Usado pela limpeza diária das janelas vencidas (cron de billing).
  @@index([expiresAt])
  @@map("rate_limits")
}
